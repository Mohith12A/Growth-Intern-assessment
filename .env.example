PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/nxtwave_arena?retryWrites=true&w=majority
MONGODB_DB=nxtwave_arena
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_SETUP_KEY=replace-with-a-one-time-random-key
CONSENT_VERSION=v1

# Optional: exported Spline scene URL for the interactive hero
VITE_SPLINE_SCENE_URL=
